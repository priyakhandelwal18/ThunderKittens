#include <iostream>
#include <string>
#include <fstream>
#include <chrono>
#include <cmath>
#include <algorithm>
#include <cuda_runtime.h>
#include "kittens.cuh"  // Contains definitions for nsa_globals, nsa_init, nsa_forward_fwd, etc.

// Constant definitions
constexpr int ATTN_B = 16;    // Batch size
constexpr int ATTN_H = 12;    // Number of heads
constexpr int ATTN_N = 1024;  // Sequence length
constexpr int BLOCK_SIZE = 16; // Block size for NSA

#undef ATTN_D
constexpr int ATTN_D = 64;    // Token dimension

// flops and efficiency helpers (unchanged)
long long flops_ref(int B, int N, int H) {
    return 2LL * B * H * N * N * ATTN_D + 2LL * B * H * N * N * ATTN_D; // Q@K.T and (Q@K.T)@V
}

long long flops_real(int B, int N, int H) {
    int chunk_size = ACTIVE_TILES * ROWS; // defined in kittens.cuh
    int n_chunks = N / chunk_size;
    return n_chunks * (2LL * B * H * chunk_size * chunk_size * ATTN_D + 2LL * B * H * chunk_size * chunk_size * ATTN_D);
}

double efficiency(long long flop, double time) {
    double tflops = flop / 1e12;
    double time_ms = time / 1e6;
    return tflops / time_ms;
}

#define CudaCheckError()    __cudaCheckError( __FILE__, __LINE__ )
inline void __cudaCheckError(const char *file, const int line) {
    cudaError_t err = cudaGetLastError();
    if (cudaSuccess != err) {
        fprintf(stderr, "cudaCheckError() failed at %s:%i : %s\n",
                file, line, cudaGetErrorString(err));
        exit(-1);
    }
    err = cudaDeviceSynchronize();
    if (cudaSuccess != err) {
        fprintf(stderr, "cudaCheckError() with sync failed at %s:%i : %s\n",
                file, line, cudaGetErrorString(err));
        exit(-1);
    }
}

int main(int argc, char **argv) {
    std::cout << "Entered NSA Forward Harness!" << std::endl;

    // TOTAL_ELEMENTS_QKVO_READ is for one tile of Q/K/V (used for I/O)
    constexpr int TOTAL_ELEMENTS_QKVO_READ = ATTN_N * ATTN_D;
    // TOTAL_ELEMENTS_QKVO covers all batch, head, token, dimension elements.
    constexpr int TOTAL_ELEMENTS_QKVO = ATTN_B * ATTN_H * ATTN_N * ATTN_D;
    // Here we assume block_indices is provided per block per head.
    // For example, if there is one block index per BLOCK_SIZE tokens per head:
    constexpr int NUM_BLOCKS = ATTN_N / BLOCK_SIZE;
    constexpr int TOTAL_ELEMENTS_INDICES = ATTN_B * ATTN_H * NUM_BLOCKS * BLOCK_SIZE;

    // Host Memory Allocation
    float *q = new float[TOTAL_ELEMENTS_QKVO_READ];
    float *k = new float[TOTAL_ELEMENTS_QKVO_READ];
    float *v = new float[TOTAL_ELEMENTS_QKVO_READ];
    float *o_ref = new float[TOTAL_ELEMENTS_QKVO_READ];

    bf16 *q_bf = new bf16[TOTAL_ELEMENTS_QKVO];
    bf16 *k_bf = new bf16[TOTAL_ELEMENTS_QKVO];
    bf16 *v_bf = new bf16[TOTAL_ELEMENTS_QKVO];
    bf16 *o_bf = new bf16[TOTAL_ELEMENTS_QKVO];
    int *block_indices = new int[TOTAL_ELEMENTS_INDICES];

    float *o = new float[TOTAL_ELEMENTS_QKVO];

    if (argc > 1) {
        std::ifstream infile(argv[1]);
        for (int i = 0; i < TOTAL_ELEMENTS_QKVO_READ; i++) infile >> q[i];
        for (int i = 0; i < TOTAL_ELEMENTS_QKVO_READ; i++) infile >> k[i];
        for (int i = 0; i < TOTAL_ELEMENTS_QKVO_READ; i++) infile >> v[i];
        for (int i = 0; i < TOTAL_ELEMENTS_QKVO_READ; i++) infile >> o_ref[i];
        for (int i = 0; i < TOTAL_ELEMENTS_INDICES; i++) infile >> block_indices[i];
        std::cout << "Finished loading input file: " << argv[1] << std::endl;
    }

    // Replicate into heads (if necessary)
    for (int i = 0; i < TOTAL_ELEMENTS_QKVO; i++) {
        q_bf[i] = __float2bfloat16(q[i % TOTAL_ELEMENTS_QKVO_READ]);
        k_bf[i] = __float2bfloat16(k[i % TOTAL_ELEMENTS_QKVO_READ]);
        v_bf[i] = __float2bfloat16(v[i % TOTAL_ELEMENTS_QKVO_READ]);
    }

    // Device Memory Allocation
    bf16 *d_q, *d_k, *d_v, *d_o;
    int *d_block_indices;
    cudaMalloc(&d_q, TOTAL_ELEMENTS_QKVO * sizeof(bf16));
    cudaMalloc(&d_k, TOTAL_ELEMENTS_QKVO * sizeof(bf16));
    cudaMalloc(&d_v, TOTAL_ELEMENTS_QKVO * sizeof(bf16));
    cudaMalloc(&d_o, TOTAL_ELEMENTS_QKVO * sizeof(bf16));
    cudaMalloc(&d_block_indices, TOTAL_ELEMENTS_INDICES * sizeof(int));

    cudaMemcpy(d_q, q_bf, TOTAL_ELEMENTS_QKVO * sizeof(bf16), cudaMemcpyHostToDevice);
    cudaMemcpy(d_k, k_bf, TOTAL_ELEMENTS_QKVO * sizeof(bf16), cudaMemcpyHostToDevice);
    cudaMemcpy(d_v, v_bf, TOTAL_ELEMENTS_QKVO * sizeof(bf16), cudaMemcpyHostToDevice);
    cudaMemcpy(d_block_indices, block_indices, TOTAL_ELEMENTS_INDICES * sizeof(int), cudaMemcpyHostToDevice);

    // Update harness calls to use the correct names and parameters.
    // Our kernel initializer is nsa_init, which requires (d_q, d_k, d_v, d_o, d_block_indices, block_size, scale, ATTN_B, ATTN_H, ATTN_N).
    // We use BLOCK_SIZE as the block size and 0.125f as the scaling factor (1/sqrt(64)).
    nsa_globals g = nsa_init(d_q, d_k, d_v, d_o, d_block_indices, BLOCK_SIZE, 0.125f, ATTN_B, ATTN_H, ATTN_N);

    cudaDeviceSynchronize();
    CudaCheckError();

    unsigned long mem_size = kittens::MAX_SHARED_MEMORY;
    std::cout << "Setting max block shared memory to " << mem_size << std::endl;

    cudaFuncSetAttribute(
        nsa_forward_fwd,
        cudaFuncAttributeMaxDynamicSharedMemorySize,
        mem_size
    );

    const int ITER = 10;
    cudaDeviceSynchronize();
    CudaCheckError();
    std::cout << "Warmup NSA Kernel\n";
    dim3 grid(ATTN_H, ATTN_B);
    for (int i = 0; i < ITER; i++) {
        nsa_forward_fwd<<<grid, NUM_THREADS, mem_size>>>(g);
    }
    cudaDeviceSynchronize();
    CudaCheckError();
    std::cout << "Starting NSA Kernel Execution\n";
    const auto start = std::chrono::high_resolution_clock::now();
    for (int i = 0; i < ITER; i++) {
        nsa_forward_fwd<<<grid, NUM_THREADS, mem_size>>>(g);
    }
    cudaDeviceSynchronize();
    const auto finish = std::chrono::high_resolution_clock::now();
    CudaCheckError();
    std::cout << "Finished NSA Kernel Execution\n";

    /*************************** Correctness Checks ****************************/
    cudaMemcpy(o_bf, d_o, TOTAL_ELEMENTS_QKVO * sizeof(bf16), cudaMemcpyDeviceToHost);
    for (int i = 0; i < TOTAL_ELEMENTS_QKVO; i++) {
        o[i] = __bfloat162float(o_bf[i]);
    }

    float max_diff = 0;
    float avg_diff = 0;
    bool good = true;

    for (int i = 0; i < TOTAL_ELEMENTS_QKVO_READ; i++) {
        float diff = o[i] - o_ref[i];
        max_diff = std::max(max_diff, std::abs(diff));
        avg_diff += std::abs(diff);
        if (std::abs(diff) > 0.05 || std::isnan(diff)) {
            good = false;
        }
    }
    avg_diff /= TOTAL_ELEMENTS_QKVO_READ;
    std::cout << "Max diff: " << max_diff << ", Avg diff: " << avg_diff << std::endl;
    std::cout << (good ? "Correct output :)\n" : "Incorrect output :(\n");

    // Efficiency Calculation
    double exec_time = std::chrono::duration_cast<std::chrono::microseconds>(finish - start).count() / double(ITER);
    std::cout << "Average execution time: " << exec_time << " us" << std::endl;
    std::cout << "Efficiency: " << efficiency(flops_real(ATTN_B, ATTN_N, ATTN_H), exec_time) << " TFLOPS\n";

    cudaFree(d_q);
    cudaFree(d_k);
    cudaFree(d_v);
    cudaFree(d_o);
    cudaFree(d_block_indices);
    delete[] q;
    delete[] k;
    delete[] v;
    delete[] o;
    delete[] o_ref;
    delete[] q_bf;
    delete[] k_bf;
    delete[] v_bf;
    delete[] o_bf;
    delete[] block_indices;

    return 0;
}
